# Логин Ozon
OZON_PHONE="Ваш Номер"
OZON_EMAIL="Ваш email"

# Откуда брать код подтверждения: gmail | manual
OTP_SOURCE=gmail
GMAIL_WAIT_TIMEOUT=60

# Пути к файлам
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
COOKIES_PATH=cookies.json
CHROME_USER_DATA_DIR="C:\Users\YourUser\AppData\Local\Google\Chrome\User Data"

# Показывать окно браузера (True) или работать в фоне (False)
BROWSER_HEADLESS=False